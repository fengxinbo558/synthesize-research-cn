      "expect": "no-trigger",
      "split": "validation",
      "near_miss_of": "web-evidence-research-cn"
    },
    {
      "q": "请概括这一份两页会议纪要的主要内容",
      "expect": "no-trigger",
      "split": "train",
      "near_miss_of": "single-document-summary"
    }
